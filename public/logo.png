<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100%" height="100%">
  <defs>
    <linearGradient id="bg-grad-png" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#1e293b" />
    </linearGradient>
    <linearGradient id="accent-grad-png" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="100%" stop-color="#2563eb" />
    </linearGradient>
  </defs>
  <!-- Base Ground -->
  <rect width="100%" height="100%" fill="url(#bg-grad-png)" rx="20" />
  
  <!-- Sleek Modern Trailing Jet / Logo Icon -->
  <g transform="translate(10, 10)">
    <!-- Grass blades stylized as jet trails -->
    <path d="M 20 65 C 30 50, 45 40, 75 35 C 55 45, 40 60, 35 75 Z" fill="url(#accent-grad-png)" opacity="0.8" />
    <path d="M 10 70 C 25 55, 45 48, 68 45 C 50 52, 32 68, 22 80 Z" fill="#38bdf8" opacity="0.9" />
    <path d="M 30 55 C 38 42, 52 30, 82 25 C 62 35, 48 50, 42 65 Z" fill="#ffffff" />
  </g>
  
  <!-- Outer metallic border ring -->
  <rect x="2" y="2" width="96" height="96" fill="none" stroke="#334155" stroke-width="1.5" rx="18" />
</svg>
