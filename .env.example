# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Environment & Validation Mode
NODE_ENV=production
STRICT_ENV=true

# Database Configuration (Database Host, Credentials & Name)
# Supports DB_HOST / MYSQL_HOST, DB_USER / MYSQL_USER, DB_PASSWORD / MYSQL_PASSWORD, DB_NAME / MYSQL_DATABASE
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=crm_saas
DATABASE_URL=

# JWT Secret for Session Management & Authentication
JWT_SECRET=your_jwt_secret_here_minimum_32_chars

# Data Encryption Key for Sensitive Payment & PII Fields
ENCRYPTION_KEY=your_encryption_key_32_bytes_hex_or_string

# TOTP / Two-Factor Authentication Configuration
TOTP_SERVICE_NAME="SkyWay CRM"
TOTP_SECRET=

# SaaS Landlord Mode
# Set to 'true' on central SaaS backend. Set to 'false' for standalone self-hosted servers.
SaaS_LANDLORD_MODE=false

# SMTP Configuration (System Email & OTP Notifications)
# Supports SMTP_USER / SMTP_EMAIL and SMTP_PASS / SMTP_APP_PASSWORD
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Global BCC Email for outgoing correspondence audit
BCC_EMAIL=


