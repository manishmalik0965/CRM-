{
  "name": "crm-saas",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "npm rimraf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:db": "vitest run tests/database",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:benchmark": "node tests/load/autocannon-benchmark.js",
    "backup:verify": "tsx scripts/backup-verify.ts",
    "restore:verify": "tsx scripts/restore-verify.ts",
    "security-check": "tsx scripts/security-audit.ts",
    "migrate": "tsx server/database/migrate.ts"
  },
  "dependencies": {
